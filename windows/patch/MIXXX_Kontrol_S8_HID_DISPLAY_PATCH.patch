+                    safeCenterPosition - safeWindowFraction / 2.0},
+            {QStringLiteral("waveformWindowEnd"),
+                    safeCenterPosition + safeWindowFraction / 2.0}};
+
+    const TrackPointer pTrack = PlayerInfo::instance().getTrackInfo(group);
+    if (!pTrack) {
+        return state;
+    }
+
+    const ConstWaveformPointer pWaveform = pTrack->getWaveform();
+    const ConstWaveformPointer pOverview = pTrack->getWaveformSummary();
+    state[QStringLiteral("available")] = true;
+    state[QStringLiteral("waveformComplete")] = pWaveform &&
+            pWaveform->getDataSize() > 0 &&
+            pWaveform->getCompletion() >= pWaveform->getDataSize();
+    state[QStringLiteral("waveform")] = downsampleWaveformWindow(pWaveform,
+            kS8WaveformBins,
+            safeCenterPosition,
+            safeWindowFraction);
+    state[QStringLiteral("overview")] = downsampleWaveform(pOverview, kS8OverviewBins);
+
+    QVariantList hotcues;
+    for (const CuePointer& pCue : pTrack->getCuePoints()) {
+        if (!pCue || pCue->getHotCue() < 0 || pCue->getHotCue() >= 8) {
+            continue;
+        }
+        hotcues.append(QVariantMap{
+                {QStringLiteral("slot"), pCue->getHotCue() + 1},
+                {QStringLiteral("position"),
+                        pCue->getPosition().toEngineSamplePosMaybeInvalid()},
+                {QStringLiteral("label"), pCue->getLabel()},
+                {QStringLiteral("color"),
+                        mixxx::RgbColor::toQString(pCue->getColor())}});
+    }
+    state[QStringLiteral("hotcues")] = hotcues;
+    return state;
+}
+
+QVariantMap ControllerScriptInterfaceLegacy::getS8BrowserState(int visibleRows) {
+    const int safeVisibleRows = qBound(4, visibleRows, 9);
+    QVariantMap state;
+    auto fetch = [&state, safeVisibleRows]() {
+        state = browserStateOnGuiThread(safeVisibleRows);
+    };
+    auto* pApp = QCoreApplication::instance();
+    if (!pApp) {
+        return browserStateOnGuiThread(safeVisibleRows);
+    }
+    if (pApp->thread() == QThread::currentThread()) {
+        fetch();
+    } else if (!QMetaObject::invokeMethod(
+                       pApp, fetch, Qt::BlockingQueuedConnection)) {
+        return QVariantMap{
+                {QStringLiteral("available"), false},
+                {QStringLiteral("rows"), QVariantList()}};
+    }
+    return state;
+}
