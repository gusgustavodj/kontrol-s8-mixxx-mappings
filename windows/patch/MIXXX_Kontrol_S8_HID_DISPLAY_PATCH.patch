+bool ControllerScriptInterfaceLegacy::s8PreviewSeek(double seconds) {
+    const double duration = ControlObject::get(ConfigKey("[PreviewDeck1]", "duration"));
+    if (!(duration > 0.0) || !std::isfinite(seconds)) {
+        return false;
+    }
+    const double current = ControlObject::get(ConfigKey("[PreviewDeck1]", "playposition"));
+    ControlObject::set(ConfigKey("[PreviewDeck1]", "playposition"),
+            qBound(0.0, current + seconds / duration, 1.0));
+    return true;
+}
