+
+class ScopedHandle {
+  public:
+    explicit ScopedHandle(HANDLE handle = INVALID_HANDLE_VALUE) : m_handle(handle) {
+    }
+
+    ~ScopedHandle() {
+        if (valid()) {
+            CloseHandle(m_handle);
+        }
+    }
+
+    ScopedHandle(const ScopedHandle&) = delete;
+    ScopedHandle& operator=(const ScopedHandle&) = delete;
+
+    bool valid() const {
+        return m_handle != INVALID_HANDLE_VALUE && m_handle != nullptr;
+    }
+
+    HANDLE get() const {
+        return m_handle;
+    }
+
+  private:
+    HANDLE m_handle;
+};
+
+class ScopedDeviceInfoSet {
+  public:
+    explicit ScopedDeviceInfoSet(HDEVINFO value = INVALID_HANDLE_VALUE) : m_value(value) {
+    }
+
+    ~ScopedDeviceInfoSet() {
+        if (m_value != INVALID_HANDLE_VALUE) {
+            SetupDiDestroyDeviceInfoList(m_value);
+        }
+    }
+
+    ScopedDeviceInfoSet(const ScopedDeviceInfoSet&) = delete;
+    ScopedDeviceInfoSet& operator=(const ScopedDeviceInfoSet&) = delete;
+
+    HDEVINFO get() const {
+        return m_value;
+    }
+
+  private:
+    HDEVINFO m_value;
+};
+
+class ScopedWriterLease {
+  public:
+    ScopedWriterLease() : m_handle(CreateMutexW(nullptr, FALSE, kWriterMutexName)) {
+        m_createError = m_handle == nullptr ? GetLastError() : ERROR_SUCCESS;
+    }
+
+    ~ScopedWriterLease() {
+        if (m_owned) {
+            ReleaseMutex(m_handle);
+        }
+        if (m_handle != nullptr) {
+            CloseHandle(m_handle);
+        }
+    }
+
+    ScopedWriterLease(const ScopedWriterLease&) = delete;
+    ScopedWriterLease& operator=(const ScopedWriterLease&) = delete;
+
+    bool valid() const {
+        return m_handle != nullptr;
+    }
+
+    DWORD createError() const {
+        return m_createError;
+    }
+
+    DWORD acquire() {
+        const DWORD result = WaitForSingleObject(m_handle, 0);
+        if (result == WAIT_OBJECT_0 || result == WAIT_ABANDONED) {
+            m_owned = true;
+        } else if (result == WAIT_FAILED) {
+            m_waitError = GetLastError();
+        }
+        return result;
+    }
+
+    DWORD waitError() const {
+        return m_waitError;
+    }
+
+  private:
+    HANDLE m_handle{nullptr};
+    bool m_owned{false};
+    DWORD m_createError{ERROR_SUCCESS};
+    DWORD m_waitError{ERROR_SUCCESS};
+};
+
+std::wstring lowerCase(std::wstring value) {
+    std::transform(value.begin(), value.end(), value.begin(), [](wchar_t value) {
+        return static_cast<wchar_t>(std::towlower(value));
+    });
+    return value;
+}
+
+bool equalsInsensitive(const std::wstring& left, const wchar_t* right) {
+    return lowerCase(left) == lowerCase(right);
+}
+
+bool startsWithInsensitive(const std::wstring& value, const wchar_t* prefix) {
+    const std::wstring prefixString(prefix);
+    return value.size() >= prefixString.size() &&
+            equalsInsensitive(value.substr(0, prefixString.size()), prefix);
+}
+
+bool containsInsensitive(const std::wstring& value, const wchar_t* needle) {
+    return lowerCase(value).find(lowerCase(needle)) != std::wstring::npos;
+}
+
+QString systemError(DWORD error) {
+    wchar_t* buffer = nullptr;
+    const DWORD length = FormatMessageW(
+            FORMAT_MESSAGE_ALLOCATE_BUFFER | FORMAT_MESSAGE_FROM_SYSTEM |
+                    FORMAT_MESSAGE_IGNORE_INSERTS,
+            nullptr,
+            error,
+            0,
+            reinterpret_cast<wchar_t*>(&buffer),
+            0,
+            nullptr);
+    QString message = length == 0 || buffer == nullptr
+            ? QStringLiteral("Win32 error %1").arg(error)
+            : QString::fromWCharArray(buffer, static_cast<int>(length)).trimmed();
+    if (buffer != nullptr) {
+        LocalFree(buffer);
+    }
+    return message;
+}
+
+bool deviceRegistryString(
+        HDEVINFO deviceInfoSet,
+        SP_DEVINFO_DATA* deviceData,
+        DWORD property,
+        std::wstring* value) {
+    DWORD type = 0;
+    DWORD required = 0;
+    SetupDiGetDeviceRegistryPropertyW(
+            deviceInfoSet, deviceData, property, &type, nullptr, 0, &required);
+    if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || required < sizeof(wchar_t)) {
+        return false;
+    }
+
+    std::vector<BYTE> storage(required + sizeof(wchar_t), 0);
+    if (!SetupDiGetDeviceRegistryPropertyW(deviceInfoSet,
+                deviceData,
+                property,
+                &type,
+                storage.data(),
+                required,
+                nullptr)) {
+        return false;
+    }
+    *value = reinterpret_cast<const wchar_t*>(storage.data());
+    return true;
+}
+
+bool findUniqueTargetPath(std::wstring* path, QString* failure) {
+    ScopedDeviceInfoSet deviceInfoSet(SetupDiGetClassDevsW(
+            &kNativeInstrumentsS8InterfaceGuid,
+            nullptr,
+            nullptr,
+            DIGCF_PRESENT | DIGCF_DEVICEINTERFACE));
+    if (deviceInfoSet.get() == INVALID_HANDLE_VALUE) {
+        *failure = QStringLiteral("SetupDiGetClassDevsW failed: %1")
+                           .arg(systemError(GetLastError()));
+        return false;
+    }
+
+    unsigned int matches = 0;
+    std::wstring candidatePath;
+    for (DWORD index = 0;; ++index) {
+        SP_DEVICE_INTERFACE_DATA interfaceData{};
+        interfaceData.cbSize = sizeof(interfaceData);
+        if (!SetupDiEnumDeviceInterfaces(deviceInfoSet.get(),
+                    nullptr,
+                    &kNativeInstrumentsS8InterfaceGuid,
+                    index,
+                    &interfaceData)) {
+            const DWORD error = GetLastError();
+            if (error == ERROR_NO_MORE_ITEMS) {
+                break;
+            }
+            *failure = QStringLiteral("SetupDiEnumDeviceInterfaces failed: %1")
+                               .arg(systemError(error));
+            return false;
+        }
+
+        DWORD required = 0;
+        SetupDiGetDeviceInterfaceDetailW(
+                deviceInfoSet.get(), &interfaceData, nullptr, 0, &required, nullptr);
+        if (GetLastError() != ERROR_INSUFFICIENT_BUFFER || required == 0) {
+            *failure = QStringLiteral("SetupDiGetDeviceInterfaceDetailW size query failed: %1")
+                               .arg(systemError(GetLastError()));
+            return false;
+        }
+
+        std::vector<BYTE> storage(required, 0);
+        auto* detail = reinterpret_cast<SP_DEVICE_INTERFACE_DETAIL_DATA_W*>(storage.data());
+        detail->cbSize = sizeof(SP_DEVICE_INTERFACE_DETAIL_DATA_W);
+        SP_DEVINFO_DATA deviceData{};
+        deviceData.cbSize = sizeof(deviceData);
+        if (!SetupDiGetDeviceInterfaceDetailW(deviceInfoSet.get(),
+                    &interfaceData,
+                    detail,
+                    required,
+                    nullptr,
+                    &deviceData)) {
+            *failure = QStringLiteral("SetupDiGetDeviceInterfaceDetailW failed: %1")
+                               .arg(systemError(GetLastError()));
+            return false;
+        }
+
+        std::vector<wchar_t> instanceIdBuffer(1024, L'\0');
+        if (!SetupDiGetDeviceInstanceIdW(deviceInfoSet.get(),
+                    &deviceData,
+                    instanceIdBuffer.data(),
+                    static_cast<DWORD>(instanceIdBuffer.size()),
+                    nullptr)) {
+            *failure = QStringLiteral("SetupDiGetDeviceInstanceIdW failed: %1")
+                               .arg(systemError(GetLastError()));
+            return false;
+        }
+
+        const std::wstring devicePath(detail->DevicePath);
+        const std::wstring instanceId(instanceIdBuffer.data());
+        if (!containsInsensitive(devicePath, kTargetPathNeedle) ||
+                !startsWithInsensitive(instanceId, kTargetInstancePrefix)) {
+            continue;
+        }
+
+        std::wstring service;
+        if (!deviceRegistryString(
+                    deviceInfoSet.get(), &deviceData, SPDRP_SERVICE, &service) ||
+                !equalsInsensitive(service, kTargetService)) {
+            *failure = QStringLiteral("MI_06 candidate is not bound to niks8usb");
+            return false;
+        }
+
+        ++matches;
+        candidatePath = devicePath;
+    }
+
+    if (matches != 1) {
+        *failure = QStringLiteral("Expected exactly one S8 MI_06 interface, found %1").arg(matches);
+        return false;
+    }
+
+    *path = std::move(candidatePath);
+    return true;
+}
+
+} // namespace
+
+class NativeNiS8DisplayTransport::Writer final : public QThread {
+  public:
+    Writer() = default;
+
+    ~Writer() override {
+        stopAndWait();
+    }
+
+    bool startAndWait(QString* failure) {
+        QMutexLocker locker(&m_mutex);
+        QThread::start();
+        QElapsedTimer startupTimer;
+        startupTimer.start();
+        while (!m_startupComplete) {
+            const qint64 elapsedMs = startupTimer.elapsed();
+            const unsigned long remainingMs = elapsedMs >= kOpenTimeoutMs
+                    ? 0
+                    : static_cast<unsigned long>(kOpenTimeoutMs - elapsedMs);
+            if (remainingMs == 0 || !m_startupReady.wait(&m_mutex, remainingMs)) {
+                m_stopRequested = true;
+                m_frameAvailable.wakeAll();
+                *failure = QStringLiteral("Timed out waiting for the native S8 display writer to open");
+                locker.unlock();
+                wait();
+                return false;
+            }
+        }
+
+        if (!m_open) {
+            *failure = m_lastFailure;
+            locker.unlock();
+            wait();
+            return false;
+        }
+        return true;
+    }
+
+    bool enqueue(const QByteArray& frame, QString* failure) {
+        if (frame.size() < static_cast<int>(NativeNiS8DisplayContract::kMinimumFrameBytes)) {
+            *failure = QStringLiteral("Refusing an S8 display frame shorter than the driver minimum");
+            return false;
+        }
+        if (frame.size() > static_cast<int>(NativeNiS8DisplayContract::kMaximumFrameBytes)) {
+            *failure = QStringLiteral("Refusing an S8 display frame larger than the encoder maximum");
+            return false;
+        }
+
+        QMutexLocker locker(&m_mutex);
+        if (!m_open || m_stopRequested || m_writeFaulted) {
+            *failure = m_lastFailure.isEmpty()
+                    ? QStringLiteral("Native S8 display writer is not open")
+                    : m_lastFailure;
+            return false;
+        }
+
+        // Retain at most the two freshest frames. The S8 mapping primes screen
+        // 0 and screen 1 synchronously at startup; a one-slot queue could lose
+        // the first frame before this worker wakes. Once both slots are used,
+        // discard the oldest unsent frame so a slow or disconnected device
+        // cannot build an unbounded backlog.
+        m_pendingFrames.push(frame);
+        m_frameAvailable.wakeOne();
+        return true;
+    }
+
+    void stopAndWait() {
+        {
+            QMutexLocker locker(&m_mutex);
+            m_stopRequested = true;
+            m_pendingFrames.clear();
+            m_frameAvailable.wakeAll();
+
+            // The writer may be blocked in the NI driver with an overlapped
+            // DeviceIoControl request. Waking the frame condition alone does
+            // not release that wait, so cancel the exact in-flight request.
+            // The OVERLAPPED and device handle remain owned by the writer
+            // thread until wait() below confirms that it has unwound.
+            if (m_activeOverlapped != nullptr && m_handle != INVALID_HANDLE_VALUE) {
+                const BOOL cancelled = CancelIoEx(m_handle, m_activeOverlapped);
+                const DWORD cancelError = cancelled ? ERROR_SUCCESS : GetLastError();
+                if (!cancelled && cancelError != ERROR_NOT_FOUND) {
+                    m_lastFailure = QStringLiteral(
+                            "CancelIoEx while stopping the S8 display writer failed: %1")
+                                            .arg(systemError(cancelError));
+                    m_writeFaulted = true;
+                }
+            }
+        }
+        wait();
+    }
+
+  protected:
+    void run() override {
+        std::wstring devicePath;
+        QString openFailure;
+        if (!findUniqueTargetPath(&devicePath, &openFailure)) {
+            finishStartup(false, openFailure);
+            return;
+        }
+
+        // One native writer owns the one MI_06 display path. The named lease
+        // protects against a duplicate controller object or a second Mixxx
+        // process without changing the driver-proven CreateFileW share flags.
+        ScopedWriterLease writerLease;
+        if (!writerLease.valid()) {
+            finishStartup(false,
+                    QStringLiteral("CreateMutexW for S8 MI_06 writer lease failed: %1")
+                            .arg(systemError(writerLease.createError())));
+            return;
+        }
+        const DWORD leaseResult = writerLease.acquire();
+        if (leaseResult == WAIT_TIMEOUT) {
+            finishStartup(false,
+                    QStringLiteral("S8 MI_06 native display writer is already owned by another process"));
+            return;
+        }
+        if (leaseResult == WAIT_FAILED) {
+            finishStartup(false,
+                    QStringLiteral("WaitForSingleObject for S8 MI_06 writer lease failed: %1")
+                            .arg(systemError(writerLease.waitError())));
+            return;
+        }
+
+        const HANDLE handle = CreateFileW(devicePath.c_str(),
+                GENERIC_READ | GENERIC_WRITE,
+                FILE_SHARE_READ | FILE_SHARE_WRITE,
+                nullptr,
+                OPEN_EXISTING,
+                FILE_FLAG_OVERLAPPED,
+                nullptr);
+        if (handle == INVALID_HANDLE_VALUE) {
+            finishStartup(false,
+                    QStringLiteral("CreateFileW for S8 MI_06 failed: %1")
+                            .arg(systemError(GetLastError())));
+            return;
+        }
+
+        {
+            QMutexLocker locker(&m_mutex);
+            m_handle = handle;
+            m_open = true;
+            m_startupComplete = true;
+            m_startupReady.wakeAll();
+        }
+
+        for (;;) {
+            QByteArray frame;
+            {
+                QMutexLocker locker(&m_mutex);
+                while (!m_stopRequested && !m_writeFaulted && m_pendingFrames.empty()) {
+                    m_frameAvailable.wait(&m_mutex);
+                }
+                if (m_stopRequested || m_writeFaulted) {
+                    // A rejected, disconnected, or timed-out request makes the
+                    // current handle terminal. Do not issue queued follow-up
+                    // IOCTLs against it; reopening is the recovery boundary.
+                    m_pendingFrames.clear();
+                    break;
+                }
+                frame = m_pendingFrames.takeNext();
+            }
+            writeFrame(frame);
+        }
+
+        CloseHandle(handle);
+        QMutexLocker locker(&m_mutex);
+        m_handle = INVALID_HANDLE_VALUE;
+        m_open = false;
+    }
+
+  private:
+    void finishStartup(bool open, const QString& failure) {
+        QMutexLocker locker(&m_mutex);
+        m_open = open;
+        m_startupComplete = true;
+        m_lastFailure = failure;
+        m_startupReady.wakeAll();
+    }
+
+    void recordFailure(const QString& failure) {
+        QMutexLocker locker(&m_mutex);
+        m_lastFailure = failure;
+        // A driver rejection or timeout is terminal for this open handle. This
+        // prevents a fast renderer or a future caller from turning one failed
+        // native request into a tight retry loop. Reopen is the explicit
+        // recovery boundary.
+        m_writeFaulted = true;
+    }
+
+    void completeCancelledOperation(HANDLE handle, OVERLAPPED* overlapped) {
+        const BOOL cancelResult = CancelIoEx(handle, overlapped);
+        const DWORD cancelError = cancelResult ? ERROR_SUCCESS : GetLastError();
+
+        // The frame and OVERLAPPED are stack-owned. Their lifetime and the
+        // handle are preserved until the driver confirms completion, including
+        // the uncommon case in which cancellation races a natural completion.
+        DWORD bytesReturned = 0;
+        const BOOL completion = GetOverlappedResult(handle, overlapped, &bytesReturned, TRUE);
+        const DWORD completionError = completion ? ERROR_SUCCESS : GetLastError();
+        if (!completion && completionError != ERROR_OPERATION_ABORTED) {
+            recordFailure(QStringLiteral("S8 display cancellation completion failed: %1")
+                                  .arg(systemError(completionError)));
+        } else if (!cancelResult && cancelError != ERROR_NOT_FOUND) {
+            recordFailure(QStringLiteral("CancelIoEx for S8 display frame failed: %1")
+                                  .arg(systemError(cancelError)));
+        }
+    }
+
+    void writeFrame(const QByteArray& frame) {
+        const ScopedHandle event(CreateEventW(nullptr, TRUE, FALSE, nullptr));
+        if (!event.valid()) {
+            recordFailure(QStringLiteral("CreateEventW for S8 display frame failed: %1")
+                                  .arg(systemError(GetLastError())));
+            return;
+        }
+
+        OVERLAPPED overlapped{};
+        overlapped.hEvent = event.get();
+        {
+            QMutexLocker locker(&m_mutex);
+            if (m_stopRequested) {
+                return;
+            }
+            m_activeOverlapped = &overlapped;
+        }
+        DWORD bytesReturned = 0;
+        const BOOL immediate = DeviceIoControl(m_handle,
+                kWriteBulkDataIoctl,
+                const_cast<char*>(frame.constData()),
+                static_cast<DWORD>(frame.size()),
+                nullptr,
+                0,
+                &bytesReturned,
+                &overlapped);
+        if (immediate) {
+            clearActiveOverlapped(&overlapped);
+            return;
+        }
+
+        const DWORD ioctlError = GetLastError();
+        if (ioctlError != ERROR_IO_PENDING) {
+            clearActiveOverlapped(&overlapped);
+            recordFailure(QStringLiteral("DeviceIoControl(0x80892880) failed: %1")
+                                  .arg(systemError(ioctlError)));
+            return;
+        }
+
+        const DWORD waitResult = WaitForSingleObject(event.get(), kWriteTimeoutMs);
+        if (waitResult == WAIT_OBJECT_0) {
+            const BOOL completed = GetOverlappedResult(m_handle, &overlapped, &bytesReturned, FALSE);
+            clearActiveOverlapped(&overlapped);
+            if (!completed) {
+                const DWORD completionError = GetLastError();
+                QMutexLocker locker(&m_mutex);
+                if (!(m_stopRequested && completionError == ERROR_OPERATION_ABORTED)) {
+                    m_lastFailure = QStringLiteral(
+                            "GetOverlappedResult for S8 display frame failed: %1")
+                                            .arg(systemError(completionError));
+                    m_writeFaulted = true;
+                }
+            }
+            return;
+        }
+
+        if (waitResult == WAIT_TIMEOUT) {
+            completeCancelledOperation(m_handle, &overlapped);
+            clearActiveOverlapped(&overlapped);
+            recordFailure(QStringLiteral("S8 display frame timed out after %1 ms; cancellation completion was awaited")
+                                  .arg(kWriteTimeoutMs));
+            return;
+        }
+
+        const DWORD waitError = GetLastError();
+        completeCancelledOperation(m_handle, &overlapped);
+        clearActiveOverlapped(&overlapped);
+        recordFailure(QStringLiteral("WaitForSingleObject for S8 display frame failed: %1")
+                              .arg(systemError(waitError)));
+    }
+
+    void clearActiveOverlapped(OVERLAPPED* overlapped) {
+        QMutexLocker locker(&m_mutex);
+        if (m_activeOverlapped == overlapped) {
+            m_activeOverlapped = nullptr;
+        }
+    }
+
+    QMutex m_mutex;
+    QWaitCondition m_startupReady;
+    QWaitCondition m_frameAvailable;
+    bool m_startupComplete = false;
+    bool m_open = false;
+    bool m_stopRequested = false;
+    bool m_writeFaulted = false;
+    HANDLE m_handle = INVALID_HANDLE_VALUE;
+    OVERLAPPED* m_activeOverlapped = nullptr;
+    NativeNiS8DisplayContract::BoundedLatestFrameQueue<QByteArray> m_pendingFrames;
+    QString m_lastFailure;
+};
+
+NativeNiS8DisplayTransport::NativeNiS8DisplayTransport() = default;
+
+NativeNiS8DisplayTransport::~NativeNiS8DisplayTransport() {
+    close();
+}
+
+bool NativeNiS8DisplayTransport::isTargetDevice(unsigned short vendorId, unsigned short productId) {
+    return NativeNiS8DisplayContract::isTargetDevice(vendorId, productId);
+}
+
+bool NativeNiS8DisplayTransport::hasUniqueTarget(QString* failure) {
+    std::wstring unusedPath;
+    return findUniqueTargetPath(&unusedPath, failure);
+}
+
+bool NativeNiS8DisplayTransport::open(QString* failure) {
+    std::lock_guard<std::mutex> locker(m_mutex);
+    if (m_pWriter) {
+        *failure = QStringLiteral("Native S8 display transport is already open");
+        return false;
+    }
+
+    auto writer = std::make_unique<Writer>();
+    if (!writer->startAndWait(failure)) {
+        return false;
+    }
+    m_pWriter = std::move(writer);
+    return true;
+}
+
+bool NativeNiS8DisplayTransport::enqueueFrame(const QByteArray& frame, QString* failure) {
+    std::lock_guard<std::mutex> locker(m_mutex);
+    if (!m_pWriter) {
+        *failure = QStringLiteral("Native S8 display transport is not open");
+        return false;
+    }
+    return m_pWriter->enqueue(frame, failure);
+}
+
+void NativeNiS8DisplayTransport::close() {
+    std::unique_ptr<Writer> writer;
+    {
+        std::lock_guard<std::mutex> locker(m_mutex);
+        writer = std::move(m_pWriter);
+    }
+    if (writer) {
+        writer->stopAndWait();
+    }
+}
+
+#endif
