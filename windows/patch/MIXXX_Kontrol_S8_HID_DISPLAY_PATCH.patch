+QVariantMap ControllerScriptInterfaceLegacy::getS8SliceWindow(const QString& group, double sliceBeats) {
+    QVariantMap result{{QStringLiteral("available"), false}};
+    if (!QRegularExpression(QStringLiteral("^\\[Channel[1-4]\\]$")).match(group).hasMatch() ||
+            !std::isfinite(sliceBeats) || sliceBeats < 0.25 || sliceBeats > 4.0) {
+        return result;
+    }
+    const TrackPointer track = PlayerInfo::instance().getTrackInfo(group);
+    if (!track) {
+        return result;
+    }
+    const auto beats = track->getBeats();
+    const double samples = getValue(group, QStringLiteral("track_samples"));
+    const double position = getValue(group, QStringLiteral("playposition"));
+    if (!beats || samples <= 0 || !std::isfinite(position)) {
+        return result;
+    }
+    const auto anchor = beats->findPrevBeat(mixxx::audio::FramePos::fromEngineSamplePosMaybeInvalid(
+            qBound(0.0, position, 1.0) * samples));
+    if (!anchor.isValid()) {
+        return result;
+    }
+    QVariantList boundaries;
+    for (int index = 0; index <= 8; ++index) {
+        const double offset = sliceBeats * index;
+        const int whole = static_cast<int>(qFloor(offset));
+        const auto begin = beats->findNthBeat(anchor, whole + 1);
+        const auto end = beats->findNthBeat(anchor, whole + 2);
+        if (!begin.isValid() || !end.isValid()) {
+            return result;
+        }
+        const double sample = begin.toEngineSamplePosMaybeInvalid() + (offset - whole) *
+                (end.toEngineSamplePosMaybeInvalid() - begin.toEngineSamplePosMaybeInvalid());
+        if (sample < 0 || sample > samples) {
+            return result;
+        }
+        boundaries.append(sample);
+    }
+    result[QStringLiteral("available")] = true;
+    result[QStringLiteral("identity")] = track->getLocation();
+    result[QStringLiteral("samples")] = samples;
+    result[QStringLiteral("sliceBeats")] = sliceBeats;
+    result[QStringLiteral("boundaries")] = boundaries;
+    {
+        const QMutexLocker lock(&s_s8SliceMutex);
+        if (s_s8SliceToken >= (quint64(1) << 52)) {
+            return {{QStringLiteral("available"), false}};
+        }
+        const quint64 token = ++s_s8SliceToken;
+        s_s8SliceIdentities[group] = {track, token};
+        result[QStringLiteral("token")] = token;
+    }
+    return result;
+}
+
+bool ControllerScriptInterfaceLegacy::isS8SliceWindowCurrent(const QString& group, double token) {
+    if (!std::isfinite(token) || token <= 0 || token != qFloor(token)) {
+        return false;
+    }
+    const TrackPointer current = PlayerInfo::instance().getTrackInfo(group);
+    const QMutexLocker lock(&s_s8SliceMutex);
+    const auto captured = s_s8SliceIdentities.value(group);
+    return current && captured.token == static_cast<quint64>(token) && captured.track.lock() == current;
+}
