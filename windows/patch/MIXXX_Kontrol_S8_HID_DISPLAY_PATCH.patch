+TEST_F(S8Bridge289Test, ArtworkWorkerProducesBounded565AndInvalidatesReplacement) {
+    QTemporaryDir dir;
+    ASSERT_TRUE(dir.isValid());
+    QImage red(64, 64, QImage::Format_RGB32);
+    red.fill(Qt::red);
+    const QString redPath = dir.filePath("red.png");
+    QImageWriter redWriter(redPath, "png");
+    ASSERT_TRUE(redWriter.write(red)) << redWriter.errorString().toStdString()
+                                     << " path=" << redPath.toStdString();
+    auto track = Track::newTemporary();
+    CoverInfoRelative cover;
+    cover.type = CoverInfoRelative::FILE;
+    cover.coverLocation = redPath;
+    track->setCoverInfo(cover);
+    PlayerInfo::instance().setTrackInfo("[Channel1]", track);
+    auto result = awaitArtwork();
+    ASSERT_TRUE(result.property("available").toBool());
+    EXPECT_EQ(64, result.property("width").toInt());
+    EXPECT_EQ(4096, result.property("pixels").property("length").toInt());
+    EXPECT_EQ(0xF800, result.property("pixels").property(0).toInt());
+    const int revision = result.property("revision").toInt();
+    for (int i = 0; i < 10; ++i) {
+        EXPECT_EQ(revision, evaluate("engine.getS8Artwork('[Channel1]').revision").toInt());
+    }
+    QImage blue(16, 16, QImage::Format_RGB32);
+    blue.fill(Qt::blue);
+    const QString bluePath = dir.filePath("blue.png");
+    ASSERT_TRUE(blue.save(bluePath));
+    cover.coverLocation = bluePath;
+    track->setCoverInfo(cover);
+    result = evaluate("engine.getS8Artwork('[Channel1]')");
+    EXPECT_FALSE(result.property("available").toBool());
+    EXPECT_GT(result.property("revision").toInt(), revision);
+    result = awaitArtwork();
+    ASSERT_TRUE(result.property("available").toBool());
+    EXPECT_EQ(0x001F, result.property("pixels").property(0).toInt());
+}
