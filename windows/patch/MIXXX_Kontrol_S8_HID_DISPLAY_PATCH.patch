+
+constexpr wchar_t kTargetPathNeedle[] = L"vid_17cc&pid_1370&mi_06";
+constexpr wchar_t kTargetInstancePrefix[] = L"USB\\VID_17CC&PID_1370&MI_06\\";
+constexpr wchar_t kTargetService[] = L"niks8usb";
