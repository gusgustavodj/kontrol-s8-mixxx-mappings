+TEST_F(S8Bridge289Test, SliceCaptureUsesNativeBeatsAndRejectsTrackEnd) {
+    auto samples = std::make_unique<ControlObject>(ConfigKey("[Channel1]", "track_samples"));
+    auto position = std::make_unique<ControlObject>(ConfigKey("[Channel1]", "playposition"));
+    samples->set(2646000);
+    position->set(0.2);
+    auto track = Track::newTemporary();
+    track->setAudioProperties(mixxx::audio::ChannelCount(2), mixxx::audio::SampleRate(44100),
+            mixxx::audio::Bitrate(), mixxx::Duration::fromSeconds(30));
+    track->trySetBeats(mixxx::Beats::fromConstTempo(track->getSampleRate(),
+            mixxx::audio::kStartFramePos, mixxx::Bpm(60.0)));
+    PlayerInfo::instance().setTrackInfo("[Channel1]", track);
+    const auto result = evaluate("engine.getS8SliceWindow('[Channel1]', 0.25)");
+    ASSERT_TRUE(result.property("available").toBool());
+    const auto boundaries = result.property("boundaries");
+    ASSERT_EQ(9, boundaries.property("length").toInt());
+    for (int i = 0; i < 9; ++i) {
+        EXPECT_DOUBLE_EQ(529200 + 22050 * i, boundaries.property(i).toNumber());
+    }
+    const QString validate = QStringLiteral("engine.isS8SliceWindowCurrent('[Channel1]', %1)")
+                                     .arg(result.property("token").toNumber());
+    EXPECT_TRUE(evaluate(validate).toBool());
+    position->set(0.999);
+    EXPECT_FALSE(evaluate("engine.getS8SliceWindow('[Channel1]', 4).available").toBool());
+    PlayerInfo::instance().setTrackInfo("[Channel1]", Track::newTemporary());
+    EXPECT_FALSE(evaluate(validate).toBool());
+}
