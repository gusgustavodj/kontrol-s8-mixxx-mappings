+QVariantMap ControllerScriptInterfaceLegacy::getS8EffectState(int effectUnit) {
+    QVariantMap result{{QStringLiteral("available"), false}};
+    if (effectUnit < 1 || effectUnit > 4) {
+        return result;
+    }
+    const QVariantMap catalog = EffectsManager::s8ControllerEffectCatalog();
+    const QVariantList visibleEffects = catalog.value(QStringLiteral("visibleEffects")).toList();
+    const QVariantList chainPresets = catalog.value(QStringLiteral("chainPresets")).toList();
+    const QString unitGroup = QStringLiteral("[EffectRack1_EffectUnit%1]").arg(effectUnit);
+    const int loadedPreset = qRound(ControlObject::get(ConfigKey(unitGroup, "loaded_chain_preset")));
+    QVariantList effectSlots;
+    for (int slot = 1; slot <= 3; ++slot) {
+        const QString slotGroup = QStringLiteral("[EffectRack1_EffectUnit%1_Effect%2]")
+                                          .arg(effectUnit)
+                                          .arg(slot);
+        const int loadedEffect = qRound(ControlObject::get(ConfigKey(slotGroup, "loaded_effect")));
+        const QVariantMap manifest = loadedEffect > 0 && loadedEffect <= visibleEffects.size()
+                ? visibleEffects.at(loadedEffect - 1).toMap()
+                : QVariantMap{};
+        const QVariantList knobNames = manifest.value(QStringLiteral("knobParameters")).toList();
+        const int parameterCount = qBound(0,
+                qRound(ControlObject::get(ConfigKey(slotGroup, "num_parameters"))),
+                8);
+        QVariantList parameters;
+        for (int parameter = 1; parameter <= parameterCount; ++parameter) {
+            const QVariantMap metadata = parameter <= knobNames.size()
+                    ? knobNames.at(parameter - 1).toMap()
+                    : QVariantMap{};
+            parameters.append(QVariantMap{{QStringLiteral("name"),
+                                                  metadata.value(QStringLiteral("shortName"),
+                                                          metadata.value(QStringLiteral("name")))},
+                    {QStringLiteral("value"), ControlObject::get(ConfigKey(
+                                                              slotGroup,
+                                                              QStringLiteral("parameter%1").arg(parameter)))}});
+        }
+        effectSlots.append(QVariantMap{{QStringLiteral("slot"), slot},
+                {QStringLiteral("loadedEffect"), loadedEffect},
+                {QStringLiteral("name"), manifest.value(QStringLiteral("name"))},
+                {QStringLiteral("enabled"),
+                        ControlObject::get(ConfigKey(slotGroup, "enabled")) > 0.0},
+                {QStringLiteral("meta"), ControlObject::get(ConfigKey(slotGroup, "meta"))},
+                {QStringLiteral("parameters"), parameters}});
+    }
+    result = catalog;
+    result[QStringLiteral("available")] = !visibleEffects.isEmpty();
+    result[QStringLiteral("unit")] = effectUnit;
+    result[QStringLiteral("enabled")] = ControlObject::get(ConfigKey(unitGroup, "enabled")) > 0.0;
+    result[QStringLiteral("mix")] = ControlObject::get(ConfigKey(unitGroup, "mix"));
+    result[QStringLiteral("mixMode")] = ControlObject::get(ConfigKey(unitGroup, "mix_mode"));
+    result[QStringLiteral("loadedChainPreset")] = loadedPreset;
+    result[QStringLiteral("loadedChainPresetName")] =
+            loadedPreset >= 0 && loadedPreset < chainPresets.size()
+            ? chainPresets.at(loadedPreset)
+            : QVariant{};
+    result[QStringLiteral("slots")] = effectSlots;
+    return result;
+}
