+#pragma once
+
+#if defined(__WINDOWS__)
+
+#include <QByteArray>
+#include <QString>
+
+#include <memory>
+#include <mutex>
+
+/// Native Windows transport for the Traktor Kontrol S8 display interface.
+///
+/// The S8 display interface is owned by the Native Instruments driver, not by
+/// libusb. This class is intentionally limited to the S8 VID/PID and to the
+/// MI_06 device interface published by niks8usb.sys.
+class NativeNiS8DisplayTransport {
+  public:
+    NativeNiS8DisplayTransport();
+    ~NativeNiS8DisplayTransport();
+
+    NativeNiS8DisplayTransport(const NativeNiS8DisplayTransport&) = delete;
+    NativeNiS8DisplayTransport& operator=(const NativeNiS8DisplayTransport&) = delete;
+
+    static bool isTargetDevice(unsigned short vendorId, unsigned short productId);
+    static bool hasUniqueTarget(QString* failure);
+
+    bool open(QString* failure);
+    bool enqueueFrame(const QByteArray& frame, QString* failure);
+    void close();
+
+  private:
+    class Writer;
+
+    std::mutex m_mutex;
+    std::unique_ptr<Writer> m_pWriter;
+};
+
+#endif
