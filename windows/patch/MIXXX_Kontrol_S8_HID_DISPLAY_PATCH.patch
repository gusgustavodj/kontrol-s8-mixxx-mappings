diff --git a/src/controllers/bulk/nativenis8displaycontract.h b/src/controllers/bulk/nativenis8displaycontract.h
new file mode 100644
index 0000000..7a516e7
--- /dev/null
+++ b/src/controllers/bulk/nativenis8displaycontract.h
@@ -0,0 +1,73 @@
+#pragma once
+
+#include <cstddef>
+#include <cstdint>
+#include <deque>
+#include <utility>
+
+/// Pure, hardware-free invariants shared by the Windows NI S8 transport and
+/// the Mission 264 offline contract test.
+namespace NativeNiS8DisplayContract {
+
+constexpr std::uint16_t kVendorId = 0x17cc;
+constexpr std::uint16_t kProductId = 0x1370;
+constexpr std::uint32_t kWriteBulkDataIoctl = 0x80892880;
+constexpr std::size_t kMinimumFrameBytes = 4;
+constexpr std::size_t kMaximumFrameBytes = 522264;
+constexpr std::size_t kMaximumPendingFrames = 2;
+
+constexpr bool isTargetDevice(std::uint16_t vendorId, std::uint16_t productId) {
+    return vendorId == kVendorId && productId == kProductId;
+}
+
+constexpr bool isValidFrameLength(std::size_t bytes) {
+    return bytes >= kMinimumFrameBytes && bytes <= kMaximumFrameBytes;
+}
+
+/// A fixed-depth, FIFO latest-frame queue. It retains the initial two S8
+/// screen frames while bounding later display backlog by dropping the oldest
+/// unsent frame when full.
+template<typename Frame, std::size_t Capacity = kMaximumPendingFrames>
+class BoundedLatestFrameQueue {
+  public:
+    static_assert(Capacity > 0);
+
+    bool empty() const {
+        return m_frames.empty();
+    }
+
+    std::size_t size() const {
+        return m_frames.size();
+    }
+
+    void clear() {
+        m_frames.clear();
+    }
+
+    void push(const Frame& frame) {
+        discardOldestIfFull();
+        m_frames.push_back(frame);
+    }
+
+    void push(Frame&& frame) {
+        discardOldestIfFull();
+        m_frames.push_back(std::move(frame));
+    }
+
+    Frame takeNext() {
+        Frame frame = std::move(m_frames.front());
+        m_frames.pop_front();
+        return frame;
+    }
+
+  private:
+    void discardOldestIfFull() {
+        if (m_frames.size() == Capacity) {
+            m_frames.pop_front();
+        }
+    }
+
+    std::deque<Frame> m_frames;
+};
+
+} // namespace NativeNiS8DisplayContract
