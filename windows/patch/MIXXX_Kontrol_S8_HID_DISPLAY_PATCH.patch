+void ControllerScriptInterfaceLegacy::configureS8Preferences(UserSettingsWeakPointer pConfig) {
+    QMutexLocker locker(&s_s8PreferencesMutex);
+    s_s8Preferences = std::move(pConfig);
+}
+
+double ControllerScriptInterfaceLegacy::getS8Preference(
+        const QString& name, double fallback) {
+    const auto range = kS8PreferenceRanges.constFind(name);
+    if (range == kS8PreferenceRanges.constEnd() || !std::isfinite(fallback)) {
+        return fallback;
+    }
+    UserSettingsPointer pConfig;
+    {
+        QMutexLocker locker(&s_s8PreferencesMutex);
+        pConfig = s_s8Preferences.toStrongRef();
+    }
+    if (!pConfig) {
+        return qBound(range->minimum, fallback, range->maximum);
+    }
+    const double value = pConfig->getValue<double>(
+            ConfigKey(QStringLiteral("[Controller]"), s8PreferenceItem(name)), fallback);
+    return qBound(range->minimum, value, range->maximum);
+}
+
+bool ControllerScriptInterfaceLegacy::setS8Preference(
+        const QString& name, double value) {
+    const auto range = kS8PreferenceRanges.constFind(name);
+    if (range == kS8PreferenceRanges.constEnd() || !std::isfinite(value) ||
+            value < range->minimum || value > range->maximum) {
+        return false;
+    }
+    UserSettingsPointer pConfig;
+    {
+        QMutexLocker locker(&s_s8PreferencesMutex);
+        pConfig = s_s8Preferences.toStrongRef();
+    }
+    if (!pConfig) {
+        return false;
+    }
+    pConfig->setValue(ConfigKey(QStringLiteral("[Controller]"), s8PreferenceItem(name)), value);
+    return true;
+}
