+bool ControllerScriptInterfaceLegacy::s8BrowserBack(bool root) {
+    bool changed = false;
+    auto navigate = [&changed, root]() {
+        auto* app = qobject_cast<QApplication*>(QCoreApplication::instance());
+        if (!app) {
+            return;
+        }
+        for (QWidget* top : app->topLevelWidgets()) {
+            auto* sidebar = top->findChild<WLibrarySidebar*>();
+            if (!sidebar || !sidebar->model()) {
+                continue;
+            }
+            QModelIndex target = sidebar->currentIndex();
+            if (root) {
+                while (target.parent().isValid()) {
+                    target = target.parent();
+                }
+            } else if (target.parent().isValid()) {
+                target = target.parent();
+            }
+            if (!target.isValid()) {
+                target = sidebar->model()->index(0, 0);
+            }
+            if (target.isValid()) {
+                sidebar->setCurrentIndex(target);
+                sidebar->scrollTo(target);
+                sidebar->setFocus(Qt::OtherFocusReason);
+                changed = true;
+            }
+            return;
+        }
+    };
+    auto* app = QCoreApplication::instance();
+    if (!app) {
+        return false;
+    }
+    if (app->thread() == QThread::currentThread()) {
+        navigate();
+    } else {
+        QMetaObject::invokeMethod(app, navigate, Qt::BlockingQueuedConnection);
+    }
+    return changed;
+}
