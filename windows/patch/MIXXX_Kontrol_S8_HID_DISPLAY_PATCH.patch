+QVariantList downsampleWaveform(const ConstWaveformPointer& pWaveform, int maxBins) {
+    QVariantList result;
+    if (!pWaveform || maxBins <= 0) {
+        return result;
+    }
+    const int available = qBound(0,
+            pWaveform->getCompletion(),
+            pWaveform->getDataSize());
+    if (available <= 0) {
+        return result;
+    }
+    const int bins = qMin(maxBins, available);
+    result.reserve(bins);
+    for (int bin = 0; bin < bins; ++bin) {
+        const int begin = (bin * available) / bins;
+        const int end = qMax(begin + 1, ((bin + 1) * available) / bins);
+        int low = 0;
+        int mid = 0;
+        int high = 0;
+        int peak = 0;
+        for (int index = begin; index < end; ++index) {
+            low = qMax(low, static_cast<int>(pWaveform->getLow(index)));
+            mid = qMax(mid, static_cast<int>(pWaveform->getMid(index)));
+            high = qMax(high, static_cast<int>(pWaveform->getHigh(index)));
+            peak = qMax(peak, static_cast<int>(pWaveform->getAll(index)));
+        }
+        result.append(QVariantMap{
+                {QStringLiteral("low"), low / 255.0},
+                {QStringLiteral("mid"), mid / 255.0},
+                {QStringLiteral("high"), high / 255.0},
+                {QStringLiteral("peak"), peak / 255.0}});
+    }
+    return result;
+}
+
+QVariantList downsampleWaveformWindow(const ConstWaveformPointer& pWaveform,
+        int bins,
+        double centerPosition,
+        double windowFraction) {
+    QVariantList result;
+    if (!pWaveform || bins <= 0) {
+        return result;
+    }
+    const int available = qBound(0,
+            pWaveform->getCompletion(),
+            pWaveform->getDataSize());
+    if (available <= 0) {
+        return result;
+    }
+
+    const double span = qBound(0.001, windowFraction, 1.0);
+    const double start = centerPosition - span / 2.0;
+    result.reserve(bins);
+    for (int bin = 0; bin < bins; ++bin) {
+        const double binStart = start + span * bin / bins;
+        const double binEnd = start + span * (bin + 1) / bins;
+        const int begin = qBound(0,
+                static_cast<int>(qFloor(binStart * available)),
+                available);
+        const int end = qBound(0,
+                static_cast<int>(qCeil(binEnd * available)),
+                available);
+        int low = 0;
+        int mid = 0;
+        int high = 0;
+        int peak = 0;
+        for (int index = begin; index < end; ++index) {
+            low = qMax(low, static_cast<int>(pWaveform->getLow(index)));
+            mid = qMax(mid, static_cast<int>(pWaveform->getMid(index)));
+            high = qMax(high, static_cast<int>(pWaveform->getHigh(index)));
+            peak = qMax(peak, static_cast<int>(pWaveform->getAll(index)));
+        }
+        result.append(QVariantMap{
+                {QStringLiteral("low"), low / 255.0},
+                {QStringLiteral("mid"), mid / 255.0},
+                {QStringLiteral("high"), high / 255.0},
+                {QStringLiteral("peak"), peak / 255.0}});
+    }
+    return result;
+}
