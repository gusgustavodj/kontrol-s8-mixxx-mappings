+void EffectsManager::publishS8ControllerEffectCatalog() {
+    QVariantList visibleEffects;
+    const auto appendManifest = [](const EffectManifestPointer& pManifest) {
+        QVariantList knobParameters;
+        QVariantList buttonParameters;
+        for (const auto& pParameter : pManifest->parameters()) {
+            QVariantMap parameter{{QStringLiteral("id"), pParameter->id()},
+                    {QStringLiteral("name"), pParameter->name()},
+                    {QStringLiteral("shortName"), pParameter->shortName()}};
+            if (pParameter->parameterType() == EffectParameterType::Knob) {
+                knobParameters.append(parameter);
+            } else if (pParameter->parameterType() == EffectParameterType::Button) {
+                buttonParameters.append(parameter);
+            }
+        }
+        return QVariantMap{{QStringLiteral("id"), pManifest->id()},
+                {QStringLiteral("name"), pManifest->displayName()},
+                {QStringLiteral("uniqueId"), pManifest->uniqueId()},
+                {QStringLiteral("mixingEq"), pManifest->isMixingEQ()},
+                {QStringLiteral("mainEq"), pManifest->isMainEQ()},
+                {QStringLiteral("knobParameters"), knobParameters},
+                {QStringLiteral("buttonParameters"), buttonParameters}};
+    };
+    for (const auto& pManifest : m_pVisibleEffectsList->getList()) {
+        visibleEffects.append(appendManifest(pManifest));
+    }
+    QVariantList allEffects;
+    for (const auto& pManifest : m_pBackendManager->getManifests()) {
+        allEffects.append(appendManifest(pManifest));
+    }
+    QVariantList chainPresets;
+    for (const auto& pPreset : m_pChainPresetManager->getPresetsSorted()) {
+        chainPresets.append(pPreset->name());
+    }
+    QVariantList quickEffectPresets;
+    for (const auto& pPreset : m_pChainPresetManager->getQuickEffectPresetsSorted()) {
+        quickEffectPresets.append(pPreset->name());
+    }
+    QVariantMap snapshot{{QStringLiteral("visibleEffects"), visibleEffects},
+            {QStringLiteral("allEffects"), allEffects},
+            {QStringLiteral("chainPresets"), chainPresets},
+            {QStringLiteral("quickEffectPresets"), quickEffectPresets}};
+    QWriteLocker locker(&s_s8ControllerEffectCatalogLock);
+    s_s8ControllerEffectCatalog = std::move(snapshot);
 }
 
