+bool ControllerScriptInterfaceLegacy::s8BrowserSort(int sortColumnId, bool descending) {
+    bool changed = false;
+    auto sort = [&changed, sortColumnId, descending]() {
+        auto* app = qobject_cast<QApplication*>(QCoreApplication::instance());
+        if (!app) {
+            return;
+        }
+        for (QWidget* top : app->topLevelWidgets()) {
+            auto* library = top->findChild<WLibrary*>();
+            auto* table = library ? library->getCurrentTrackTableView() : nullptr;
+            auto* model = table ? dynamic_cast<TrackModel*>(table->model()) : nullptr;
+            if (!table || !model) {
+                continue;
+            }
+            const auto columnId = static_cast<TrackModel::SortColumnId>(sortColumnId);
+            const int column = model->columnIndexFromSortColumnId(columnId);
+            if (column < 0 || !model->isColumnSortable(column)) {
+                return;
+            }
+            const Qt::SortOrder order = descending
+                    ? Qt::DescendingOrder
+                    : Qt::AscendingOrder;
+            QHeaderView* header = table->horizontalHeader();
+            if (!header || (header->sortIndicatorSection() == column &&
+                                   header->sortIndicatorOrder() == order)) {
+                return;
+            }
+            // Follow the same signal path as a user clicking the table header.
+            // WTrackTableView::slotSortingChanged() then calls doSortByColumn(),
+            // which preserves the complete selection and never replaces the
+            // current library model.
+            header->setSortIndicator(column, order);
+            changed = true;
+            return;
+        }
+    };
+    auto* app = QCoreApplication::instance();
+    if (!app) {
+        return false;
+    }
+    if (app->thread() == QThread::currentThread()) {
+        sort();
+    } else {
+        QMetaObject::invokeMethod(app, sort, Qt::BlockingQueuedConnection);
+    }
+    return changed;
+}
