+            mixxx::experimental::audio_diagnostics::AudioDiagnostics::nowNs() - scalerStartNs,
+            false);
+}
+
+bool EngineBuffer::scalerSampleRatesMatchLocked(mixxx::audio::SampleRate sampleRate) const {
+    if (!sampleRate.isValid() ||
+            m_pScaleLinear->getOutputSignal().getSampleRate() != sampleRate ||
+            m_pScaleST->getOutputSignal().getSampleRate() != sampleRate) {
+        return false;
+    }
+#ifdef __RUBBERBAND__
+    if (m_pScaleRB->getOutputSignal().getSampleRate() != sampleRate) {
+        return false;
+    }
+#endif
+    return true;
+}
