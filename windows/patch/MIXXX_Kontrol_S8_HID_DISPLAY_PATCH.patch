diff --git a/src/soundio/experimentalaudiodiagnostics.h b/src/soundio/experimentalaudiodiagnostics.h
new file mode 100644
index 0000000..26275e0
--- /dev/null
+++ b/src/soundio/experimentalaudiodiagnostics.h
@@ -0,0 +1,217 @@
+// M10038 experimental diagnostics. This header is intentionally header-only so
+// the instrumentation does not change the production target graph.
+#pragma once
+
+#include <array>
+#include <atomic>
+#include <chrono>
+#include <cstdint>
+#include <limits>
+
+#include <QString>
+
+namespace mixxx::experimental::audio_diagnostics {
+
+class AudioDiagnostics {
+  public:
+    static constexpr int kDurationBuckets = 64;
+    static constexpr int kUnderflowCodes = 32;
+    static constexpr std::uint64_t kLoadCorrelationWindowNs = 5'000'000'000ULL;
+
+    AudioDiagnostics() {
+        for (auto& count : m_durationBuckets) {
+            count.store(0, std::memory_order_relaxed);
+        }
+        for (auto& count : m_underflowCodes) {
+            count.store(0, std::memory_order_relaxed);
+        }
+        for (auto& count : m_statusFlags) {
+            count.store(0, std::memory_order_relaxed);
+        }
+    }
+
+    static std::uint64_t nowNs() {
+        return static_cast<std::uint64_t>(
+                std::chrono::duration_cast<std::chrono::nanoseconds>(
+                        std::chrono::steady_clock::now().time_since_epoch())
+                        .count());
+    }
+
+    void recordCallbackStart(std::uint64_t startNs,
+            std::uint32_t framesPerBuffer,
+            std::uint32_t statusFlags) {
+        m_callbackCount.fetch_add(1, std::memory_order_relaxed);
+        m_callbackFrames.fetch_add(framesPerBuffer, std::memory_order_relaxed);
+        updateMax(m_maxFrames, framesPerBuffer);
+        updateMin(m_minFrames, framesPerBuffer);
+        for (std::uint32_t bit = 0; bit < m_statusFlags.size(); ++bit) {
+            if (statusFlags & (1U << bit)) {
+                m_statusFlags[bit].fetch_add(1, std::memory_order_relaxed);
+            }
+        }
+        m_lastCallbackStartNs.store(startNs, std::memory_order_relaxed);
+    }
+
+    void recordCallbackEnd(std::uint64_t startNs) {
+        const std::uint64_t endNs = nowNs();
+        const std::uint64_t durationNs = endNs - startNs;
+        m_callbackDurationTotalNs.fetch_add(durationNs, std::memory_order_relaxed);
+        updateMax(m_callbackDurationMaxNs, durationNs);
+        m_durationBuckets[durationBucket(durationNs)].fetch_add(1, std::memory_order_relaxed);
+
+        const std::uint64_t loadNs = m_lastTrackLoadNs.load(std::memory_order_relaxed);
+        if (loadNs <= endNs && endNs - loadNs <= kLoadCorrelationWindowNs) {
+            m_callbacksWithinLoadWindow.fetch_add(1, std::memory_order_relaxed);
+            updateMax(m_callbackDurationMaxWithinLoadWindowNs, durationNs);
+        }
+    }
+
+    void recordTrackLoaded() {
+        m_trackLoadCount.fetch_add(1, std::memory_order_relaxed);
+        m_lastTrackLoadNs.store(nowNs(), std::memory_order_relaxed);
+    }
+
+    void recordScalerPreparation(std::uint64_t durationNs, bool inCallback) {
+        if (inCallback) {
+            m_callbackScalerCount.fetch_add(1, std::memory_order_relaxed);
+            m_callbackScalerTotalNs.fetch_add(durationNs, std::memory_order_relaxed);
+            updateMax(m_callbackScalerMaxNs, durationNs);
+        } else {
+            m_prewarmScalerCount.fetch_add(1, std::memory_order_relaxed);
+            m_prewarmScalerTotalNs.fetch_add(durationNs, std::memory_order_relaxed);
+            updateMax(m_prewarmScalerMaxNs, durationNs);
+        }
+    }
+
+    void recordLockWait(std::uint64_t durationNs) {
+        m_lockWaitCount.fetch_add(1, std::memory_order_relaxed);
+        m_lockWaitTotalNs.fetch_add(durationNs, std::memory_order_relaxed);
+        updateMax(m_lockWaitMaxNs, durationNs);
+    }
+
+    void recordUnderflow(int code) {
+        if (code >= 0 && code < kUnderflowCodes) {
+            m_underflowCodes[code].fetch_add(1, std::memory_order_relaxed);
+        }
+    }
+
+    void recordAudioLatencyOverload() {
+        m_audioLatencyOverloadCount.fetch_add(1, std::memory_order_relaxed);
+    }
+
+    QString summary() const {
+        const std::uint64_t callbacks = m_callbackCount.load(std::memory_order_relaxed);
+        return QStringLiteral("callbacks=%1 frames_total=%2 frames_min=%3 frames_max=%4 "
+                              "callback_ns_total=%5 callback_ns_max=%6 callback_ns_p95_approx=%7 "
+                              "track_loads=%8 callbacks_5s_after_load=%9 callback_ns_max_5s_after_load=%10 "
+                              "status_input_underflow=%11 status_input_overflow=%12 "
+                              "status_output_underflow=%13 status_output_overflow=%14 status_priming=%15 "
+                              "underflow_code_1=%16 underflow_code_2=%17 underflow_code_3=%18 "
+                              "underflow_code_4=%19 underflow_code_5=%20 underflow_code_6=%21 "
+                              "audio_latency_overload_events=%22 callback_scaler_calls=%23 "
+                              "callback_scaler_ns_total=%24 callback_scaler_ns_max=%25 "
+                              "prewarm_scaler_calls=%26 prewarm_scaler_ns_total=%27 prewarm_scaler_ns_max=%28 "
+                              "lock_wait_calls=%29 lock_wait_ns_total=%30 lock_wait_ns_max=%31")
+                .arg(callbacks)
+                .arg(m_callbackFrames.load(std::memory_order_relaxed))
+                .arg(m_minFrames.load(std::memory_order_relaxed) == std::numeric_limits<std::uint64_t>::max()
+                                ? 0
+                                : m_minFrames.load(std::memory_order_relaxed))
+                .arg(m_maxFrames.load(std::memory_order_relaxed))
+                .arg(m_callbackDurationTotalNs.load(std::memory_order_relaxed))
+                .arg(m_callbackDurationMaxNs.load(std::memory_order_relaxed))
+                .arg(durationPercentileNs(callbacks, 95))
+                .arg(m_trackLoadCount.load(std::memory_order_relaxed))
+                .arg(m_callbacksWithinLoadWindow.load(std::memory_order_relaxed))
+                .arg(m_callbackDurationMaxWithinLoadWindowNs.load(std::memory_order_relaxed))
+                .arg(m_statusFlags[0].load(std::memory_order_relaxed))
+                .arg(m_statusFlags[1].load(std::memory_order_relaxed))
+                .arg(m_statusFlags[2].load(std::memory_order_relaxed))
+                .arg(m_statusFlags[3].load(std::memory_order_relaxed))
+                .arg(m_statusFlags[4].load(std::memory_order_relaxed))
+                .arg(m_underflowCodes[1].load(std::memory_order_relaxed))
+                .arg(m_underflowCodes[2].load(std::memory_order_relaxed))
+                .arg(m_underflowCodes[3].load(std::memory_order_relaxed))
+                .arg(m_underflowCodes[4].load(std::memory_order_relaxed))
+                .arg(m_underflowCodes[5].load(std::memory_order_relaxed))
+                .arg(m_underflowCodes[6].load(std::memory_order_relaxed))
+                .arg(m_audioLatencyOverloadCount.load(std::memory_order_relaxed))
+                .arg(m_callbackScalerCount.load(std::memory_order_relaxed))
+                .arg(m_callbackScalerTotalNs.load(std::memory_order_relaxed))
+                .arg(m_callbackScalerMaxNs.load(std::memory_order_relaxed))
+                .arg(m_prewarmScalerCount.load(std::memory_order_relaxed))
+                .arg(m_prewarmScalerTotalNs.load(std::memory_order_relaxed))
+                .arg(m_prewarmScalerMaxNs.load(std::memory_order_relaxed))
+                .arg(m_lockWaitCount.load(std::memory_order_relaxed))
+                .arg(m_lockWaitTotalNs.load(std::memory_order_relaxed))
+                .arg(m_lockWaitMaxNs.load(std::memory_order_relaxed));
+    }
+
+  private:
+    static int durationBucket(std::uint64_t durationNs) {
+        int bucket = 0;
+        while (durationNs > 1 && bucket < kDurationBuckets - 1) {
+            durationNs >>= 1;
+            ++bucket;
+        }
+        return bucket;
+    }
+
+    std::uint64_t durationPercentileNs(std::uint64_t callbackCount, int percentile) const {
+        if (callbackCount == 0) {
+            return 0;
+        }
+        const std::uint64_t target = (callbackCount * percentile + 99) / 100;
+        std::uint64_t cumulative = 0;
+        for (int bucket = 0; bucket < kDurationBuckets; ++bucket) {
+            cumulative += m_durationBuckets[bucket].load(std::memory_order_relaxed);
+            if (cumulative >= target) {
+                return 1ULL << bucket;
+            }
+        }
+        return 1ULL << (kDurationBuckets - 1);
+    }
+
+    static void updateMax(std::atomic<std::uint64_t>& target, std::uint64_t value) {
+        std::uint64_t previous = target.load(std::memory_order_relaxed);
+        while (previous < value &&
+                !target.compare_exchange_weak(previous, value, std::memory_order_relaxed)) {
+        }
+    }
+
+    static void updateMin(std::atomic<std::uint64_t>& target, std::uint64_t value) {
+        std::uint64_t previous = target.load(std::memory_order_relaxed);
+        while (previous > value &&
+                !target.compare_exchange_weak(previous, value, std::memory_order_relaxed)) {
+        }
+    }
+
+    std::atomic<std::uint64_t> m_callbackCount{0};
+    std::atomic<std::uint64_t> m_callbackFrames{0};
+    std::atomic<std::uint64_t> m_minFrames{std::numeric_limits<std::uint64_t>::max()};
+    std::atomic<std::uint64_t> m_maxFrames{0};
+    std::atomic<std::uint64_t> m_callbackDurationTotalNs{0};
+    std::atomic<std::uint64_t> m_callbackDurationMaxNs{0};
+    std::array<std::atomic<std::uint64_t>, kDurationBuckets> m_durationBuckets;
+    std::array<std::atomic<std::uint64_t>, kUnderflowCodes> m_underflowCodes;
+    std::array<std::atomic<std::uint64_t>, 32> m_statusFlags;
+    std::atomic<std::uint64_t> m_lastCallbackStartNs{0};
+    std::atomic<std::uint64_t> m_trackLoadCount{0};
+    std::atomic<std::uint64_t> m_lastTrackLoadNs{0};
+    std::atomic<std::uint64_t> m_callbacksWithinLoadWindow{0};
+    std::atomic<std::uint64_t> m_callbackDurationMaxWithinLoadWindowNs{0};
+    std::atomic<std::uint64_t> m_callbackScalerCount{0};
+    std::atomic<std::uint64_t> m_callbackScalerTotalNs{0};
+    std::atomic<std::uint64_t> m_callbackScalerMaxNs{0};
+    std::atomic<std::uint64_t> m_prewarmScalerCount{0};
+    std::atomic<std::uint64_t> m_prewarmScalerTotalNs{0};
+    std::atomic<std::uint64_t> m_prewarmScalerMaxNs{0};
+    std::atomic<std::uint64_t> m_lockWaitCount{0};
+    std::atomic<std::uint64_t> m_lockWaitTotalNs{0};
+    std::atomic<std::uint64_t> m_lockWaitMaxNs{0};
+    std::atomic<std::uint64_t> m_audioLatencyOverloadCount{0};
+};
+
+inline AudioDiagnostics g_audioDiagnostics;
+
+} // namespace mixxx::experimental::audio_diagnostics
