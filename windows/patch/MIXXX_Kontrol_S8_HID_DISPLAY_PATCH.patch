+bool ControllerScriptInterfaceLegacy::s8PreviewSelected(bool play) {
+    bool changed = false;
+    auto preview = [&changed, play]() {
+        if (!play) {
+            ControlObject::set(ConfigKey("[PreviewDeck1]", "play"), 0.0);
+            changed = true;
+            return;
+        }
+        auto* app = qobject_cast<QApplication*>(QCoreApplication::instance());
+        if (!app) {
+            return;
+        }
+        for (QWidget* top : app->topLevelWidgets()) {
+            auto* library = top->findChild<WLibrary*>();
+            auto* table = library ? library->getCurrentTrackTableView() : nullptr;
+            if (!table || !table->currentIndex().isValid()) {
+                continue;
+            }
+            table->loadSelectedTrackToGroup(QStringLiteral("[PreviewDeck1]"), true);
+            changed = true;
+            return;
+        }
+    };
+    auto* app = QCoreApplication::instance();
+    if (!app) {
+        return false;
+    }
+    if (app->thread() == QThread::currentThread()) {
+        preview();
+    } else {
+        QMetaObject::invokeMethod(app, preview, Qt::BlockingQueuedConnection);
+    }
+    return changed;
+}
