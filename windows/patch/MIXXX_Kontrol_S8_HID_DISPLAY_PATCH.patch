+QVariantMap ControllerScriptInterfaceLegacy::getS8Artwork(const QString& group) {
+    if (!QRegularExpression(QStringLiteral("^\\[Channel[1-4]\\]$")).match(group).hasMatch()) {
+        return {{QStringLiteral("available"), false}};
+    }
+    const TrackPointer track = PlayerInfo::instance().getTrackInfo(group);
+    CoverInfo cover;
+    if (track) {
+        cover = track->getCoverInfoWithLocation();
+    }
+    auto& entry = m_s8Artwork[group];
+    // Do not queue another decode until the previous job finishes. Invalidate
+    // immediately on replacement; an obsolete cover is never returned.
+    if (!entry.initialized || entry.cover != cover) {
+        entry.cover = cover;
+        entry.initialized = true;
+        ++entry.revision;
+        entry.state = {{QStringLiteral("available"), false},
+                {QStringLiteral("revision"), entry.revision}};
+    }
+    if (entry.pendingActive && !entry.pending.isFinished()) {
+        return entry.state;
+    }
+    if (entry.pendingActive && entry.pending.isFinished()) {
+        const QVariantMap result = entry.pending.result();
+        entry.pending = {};
+        entry.pendingActive = false;
+        if (result.value(QStringLiteral("revision")).toULongLong() == entry.revision) {
+            entry.state = result;
+            entry.state[QStringLiteral("decoded")] = true;
+        }
+    }
+    if (!entry.state.value(QStringLiteral("decoded")).toBool()) {
+        const quint64 revision = entry.revision;
+        if (!track || cover.type == CoverInfoRelative::NONE) {
+            entry.state[QStringLiteral("decoded")] = true;
+        } else {
+            entry.pendingActive = true;
+            entry.pending = QtConcurrent::run([cover, track, revision]() {
+                QVariantMap result{{QStringLiteral("available"), false},
+                        {QStringLiteral("revision"), revision}};
+                const QImage image = cover.loadImage(track).image;
+                if (image.isNull()) {
+                    return result;
+                }
+                const QImage thumb = image.scaled(64, 64, Qt::KeepAspectRatio,
+                        Qt::SmoothTransformation).convertToFormat(QImage::Format_RGB32);
+                QVariantList pixels;
+                pixels.reserve(thumb.width() * thumb.height());
+                for (int y = 0; y < thumb.height(); ++y) {
+                    const auto* row = reinterpret_cast<const QRgb*>(thumb.constScanLine(y));
+                    for (int x = 0; x < thumb.width(); ++x) {
+                        pixels.append(((qRed(row[x]) >> 3) << 11) |
+                                ((qGreen(row[x]) >> 2) << 5) | (qBlue(row[x]) >> 3));
+                    }
+                }
+                result[QStringLiteral("available")] = true;
+                result[QStringLiteral("width")] = thumb.width();
+                result[QStringLiteral("height")] = thumb.height();
+                result[QStringLiteral("pixels")] = pixels;
+                return result;
+            });
+        }
+    }
+    return entry.state;
+}
